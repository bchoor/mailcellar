{
  // MailCellar on the Bchoor@gmail.com Cloudflare account, Workers Free.
  // One Worker serves the app (static assets) and the API (/api/*), and hosts the
  // per-user mailbox Durable Object, and the sync Workflow that copies Gmail into it.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mailcellar",
  "account_id": "87a4f50952b4b2ce00cab6c2680e63ae",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "mailcellar.icaruslab.dev", "custom_domain": true }],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_VERSION": "dev",
    // Cloudflare Access app "icaruslab.dev apps (wildcard)", which covers this domain.
    "ACCESS_TEAM_DOMAIN": "https://bchoor.cloudflareaccess.com",
    "ACCESS_AUD": "3b94450e06686e3e57c6a9bf1f017485bb9750730246009dddd9739955009fb0"
  },
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "MailboxDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxDO"] }],
  "workflows": [{ "name": "mailcellar-sync", "binding": "SYNC", "class_name": "SyncWorkflow" }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "mailcellar" }],
  "observability": { "enabled": true },
  // wrangler dev keeps localhost as the request's origin (not the route's host), so the
  // Google sign-in redirect matches the client's http://localhost:8787 callback.
  "dev": { "port": 8787, "host": "localhost:8787" }
}
