{
  // One Worker serves the public page (/), the app (/app, static assets) and the API (/api/*), and hosts the per-mailbox
  // Durable Objects and the sync Workflow that copies Gmail into them. Setup: docs/setup.md.
  // Nothing here names an account or domain: the account comes from your wrangler login (or
  // CLOUDFLARE_ACCOUNT_ID), the custom domain is set on the Worker in the dashboard, and the
  // deployment's own values are Worker variables and secrets, which keep_vars keeps on deploy.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mailcellar",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    // The public page is the site root; the app is under /app. The Worker answers the app's
    // addresses (falling back to its index.html) and moves the app's old addresses to /app.
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*", "/mcp", "/app", "/app/*", "!/app/assets/*",
      "/m/*", "/messages", "/panes", "/gmail/*", "/senders", "/domains", "/labels", "/time", "/backfill", "/usage"
    ]
  },
  "vars": {
    "APP_VERSION": "dev",
    // The R2 bucket that holds the raw files; must match r2_buckets below.
    "ARCHIVE_BUCKET": "mailcellar"
    // Set per deployment (docs/setup.md), not here: CF_ACCOUNT_ID, ACCESS_TEAM_DOMAIN, ACCESS_AUD, MCP_ACCESS_AUD,
    // ADMIN_EMAILS; secrets GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CF_ANALYTICS_TOKEN,
    // CF_BILLING_TOKEN.
  },
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "MailboxDO" },
      // The account's meters for its plan, shared by every user (quota.ts).
      { "name": "QUOTA", "class_name": "QuotaDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MailboxDO"] },
    { "tag": "v2", "new_sqlite_classes": ["QuotaDO"] }
  ],
  "workflows": [{ "name": "mailcellar-sync", "binding": "SYNC", "class_name": "SyncWorkflow" }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "mailcellar" }],
  "observability": { "enabled": true },
  // Workers Paid (2026-10-25): runs estimate their CPU at a third of 30 s, and estimates have run
  // low before, so the cap is 2 minutes. Remove if the account goes back to Free (WORKERS_PLAN).
  "limits": { "cpu_ms": 120000 },
  // wrangler dev keeps localhost as the request's origin (not the route's host), so the
  // Google sign-in redirect matches the client's http://localhost:8787 callback.
  "dev": { "port": 8787, "host": "localhost:8787" }
}
